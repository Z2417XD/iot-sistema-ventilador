<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla principal. Fondo degradado asignado desde MainActivity según el nivel de temperatura.
     fitsSystemWindows: separa el contenido de las barras del sistema. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:background="#1565C0"
    tools:context=".MainActivity">

    <!-- AnchoContenido: ancho completo en teléfonos, ancho máximo centrado en tablets -->
    <LinearLayout
        android:id="@+id/contenido"
        style="@style/AnchoContenido"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_principal"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="@color/blanco" />

        <!-- ============ Conexión ============ -->
        <Button
            android:id="@+id/btnConectar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/conectar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvConexion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/conexion_inicio"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/blanco" />

            <Button
                android:id="@+id/btnDemo"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/modo_demo" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/aviso"
            android:visibility="gone" />

        <!-- ============ Estado de la habitación ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/temperatura_ambiental"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="@color/blanco_suave" />

            <!-- Indicador de temperatura con la zona de confort (17 a 25 °C) -->
            <FrameLayout
                android:layout_width="260dp"
                android:layout_height="260dp">

                <com.example.myapplication.TermometroView
                    android:id="@+id/termometro"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <!-- "tnum": números de ancho fijo -->
                    <TextView
                        android:id="@+id/tvTemperatura"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:text="@string/sin_valor"
                        android:textColor="@color/blanco"
                        android:textSize="52sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvEstado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nivel_sin_datos"
                        android:textColor="@color/blanco"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/tvDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/detalle_conectate"
                android:textColor="@color/blanco"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvHumedad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/blanco_suave"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ============ Simulación (visible solo en modo demo) ============ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSimulacion"
            style="@style/TarjetaVidrio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/simulacion_titulo"
                    android:textColor="@color/blanco"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/simulacion_ayuda"
                    android:textColor="@color/blanco_suave"
                    android:textSize="13sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/slSimulacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:contentDescription="@string/desc_simulacion"
                    android:stepSize="1"
                    android:value="23"
                    android:valueFrom="5"
                    android:valueTo="40"
                    app:tickVisible="false"
                    app:trackColorInactive="@color/vidrio_fuerte" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/simulacion_min"
                        android:textColor="@color/blanco_tenue"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/simulacion_max"
                        android:textColor="@color/blanco_tenue"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ Ventilador (control manual) ============ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/TarjetaVidrio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.example.myapplication.VentiladorView
                        android:id="@+id/ventiladorIcono"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ventilador"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="@color/blanco" />

                        <TextView
                            android:id="@+id/tvVentiladorEstado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sin_datos"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/blanco_suave" />
                    </LinearLayout>

                    <!-- contentDescription: descripción del switch para el lector de pantalla -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swVentilador"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:contentDescription="@string/desc_switch_ventilador" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/ventilador_ayuda"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/blanco_suave" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============ Historial ============ -->
        <Button
            android:id="@+id/btnVerHistorial"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/ver_historial" />
    </LinearLayout>
</ScrollView>
