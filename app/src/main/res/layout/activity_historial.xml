<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de historial. Fondo degradado asignado desde HistorialActivity. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raizHistorial"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:background="#2E7D32"
    tools:context=".HistorialActivity">

    <LinearLayout
        style="@style/AnchoContenido"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnVolver"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/volver"
                android:textColor="@color/blanco" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/historial_titulo"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="@color/blanco" />
        </LinearLayout>

        <!-- Parámetros -->
        <com.google.android.material.card.MaterialCardView
            style="@style/TarjetaVidrio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/tvParametros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:padding="16dp"
                android:text="@string/historial_cargando"
                android:textColor="@color/blanco"
                android:textSize="16sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Historial -->
        <com.google.android.material.card.MaterialCardView
            style="@style/TarjetaVidrio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ultimos_5_minutos"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="@color/blanco" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/leyenda_grafico"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/blanco_suave" />

                <com.example.myapplication.HistorialView
                    android:id="@+id/graficoHistorial"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="16dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Métricas de las lecturas y botón de guardado en Firebase -->
        <com.google.android.material.card.MaterialCardView
            style="@style/TarjetaVidrio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/metricas_titulo"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="@color/blanco" />

                <TextView
                    android:id="@+id/tvMetricas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/metricas_sin_datos"
                    android:textColor="@color/blanco"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnGuardarMetricas"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/metricas_guardar" />

                <TextView
                    android:id="@+id/tvGuardado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/blanco_suave" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
